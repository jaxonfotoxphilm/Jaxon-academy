# Copy this file to .env and fill in your keys

# Supabase (student progress tracking)
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ElevenLabs TTS — get a free key at https://elevenlabs.io
# Free tier: ~10,000 chars/month of ultra-realistic voice.
# When exhausted, the app automatically falls back to Kokoro TTS (also realistic, runs locally).
VITE_ELEVENLABS_API_KEY=your_elevenlabs_key_here
